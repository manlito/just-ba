# Concatenates INPUTS (a list of files) into a C++ string constant named SYMBOL in OUT.
# '#pragma once' lines are dropped, since the result is a single translation unit.
set(_text "")
foreach(_in IN LISTS INPUTS)
  file(READ "${_in}" _part)
  string(REPLACE "#pragma once" "" _part "${_part}")
  string(APPEND _text "${_part}\n")
endforeach()
string(FIND "${_text}" ")jbatext\"" _clash)
if(NOT _clash EQUAL -1)
  message(FATAL_ERROR "input contains the raw string delimiter")
endif()
file(WRITE "${OUT}.tmp"
  "// Generated by cmake/EmbedText.cmake. Do not edit.\n"
  "extern const char* const ${SYMBOL};\n"
  "const char* const ${SYMBOL} = R\"jbatext(${_text})jbatext\";\n")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
